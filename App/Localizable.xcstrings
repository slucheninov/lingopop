        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz tekst w dowolnym miejscu na Macu, naciśnij skrót i uzyskaj natychmiastowe tłumaczenie AI, poprawkę gramatyki lub przepisanie tekstu w oknie obok kursora."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
